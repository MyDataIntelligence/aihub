{
  "name": "@ferronhooi/aihub",
  "version": "1.6.0",
  "description": "One small CLI for Azure DevOps team workflows used by coding agents (stories, pull requests, reviews, cherry-picks).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "aihub": "dist/cli.js"
  },
  "files": [
    "dist",
    "pack"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-pack.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "lint:skills": "node dist/tools/lintSkills.js ../skills"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "tedious": "^19.2.2",
    "yaml": "^2.6.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MyDataIntelligence/aihub",
    "directory": "cli"
  },
  "homepage": "https://github.com/MyDataIntelligence/aihub#readme",
  "bugs": {
    "url": "https://github.com/MyDataIntelligence/aihub/issues"
  }
}
