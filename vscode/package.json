{
  "name": "ai-context-hub",
  "displayName": "AI Context Hub",
  "description": "A thin status bar and panel over the aihub CLI: story, branch, pull request, pipeline, review threads, Fabric runs and watch events. Actions open in your chat (Copilot Chat or opencode).",
  "version": "3.1.2",
  "publisher": "FerronHooi",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/MyDataIntelligence/aihub",
    "directory": "vscode"
  },
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=18"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
