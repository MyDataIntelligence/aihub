          "when": "view == aihub.learn && viewItem == aihubLearnConcept",
          "group": "1_learn@1"
        },
        {
          "command": "aihub.stories.open",
          "when": "view == aihub.myStories && viewItem == aihubStory",
          "group": "inline@0"
        },
        {
          "command": "aihub.stories.link",
          "when": "view == aihub.myStories && viewItem == aihubStory",
          "group": "inline@1"
        },
        {
          "command": "aihub.stories.markCurrent",
          "when": "view == aihub.myStories && viewItem =~ /^aihubStoryBranch-(old|parked)/",
          "group": "inline@0"
        },
        {
          "command": "aihub.stories.markOld",
          "when": "view == aihub.myStories && viewItem =~ /^aihubStoryBranch-(current|parked)/",
          "group": "inline@1"
        },
        {
          "command": "aihub.stories.markCurrent",
          "when": "view == aihub.myStories && viewItem =~ /^aihubStoryBranch-(old|parked)/",
          "group": "1_star@0"
        },
        {
          "command": "aihub.stories.markOld",
          "when": "view == aihub.myStories && viewItem =~ /^aihubStoryBranch-(current|parked)/",
          "group": "1_star@1"
        },
        {
          "command": "aihub.stories.markParked",
          "when": "view == aihub.myStories && viewItem =~ /^aihubStoryBranch-(current|old)/",
          "group": "1_star@2"
        },
        {
          "command": "aihub.stories.label",
          "when": "view == aihub.myStories && viewItem =~ /^aihubStoryBranch-/",
          "group": "1_star@3"
        },
        {
          "command": "aihub.stories.openWorktree",
          "when": "view == aihub.myStories && viewItem =~ /^aihubStoryBranch-.*-wt$/",
          "group": "2_open@0"
        },
        {
          "command": "aihub.stories.unlink",
          "when": "view == aihub.myStories && viewItem =~ /^aihubStoryBranch-/",
          "group": "3_remove@0"
        },
        {
          "command": "aihub.stories.remove",
          "when": "view == aihub.myStories && viewItem =~ /^aihubStoryBranch-/",
          "group": "3_remove@1"
        }
      ],
      "aihub.cm.DevOps": [
        {
          "command": "aihub.chat.story",
          "group": "1_x@1"
        },
        {
          "command": "aihub.chat.refine",
