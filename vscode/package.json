    "viewsWelcome": [
      {
        "view": "aihub.worktreeSets",
        "contents": "No worktree sets yet.\n[Create worktrees](command:aihub.worktrees.create)\nOne branch in several repositories, in one folder and one workspace."
      },
      {
        "view": "aihub.learn",
        "contents": "No lessons yet.\nAsk your chat for /leer on a pull request or branch: it explains the change with pictures and saves it here, in your personal store."
      }
    ],
    "keybindings": [
      {
        "command": "aihub.reposet.open",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b"
      }
    ]
