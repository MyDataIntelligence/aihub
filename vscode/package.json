    "configuration": {
      "title": "AI Context Hub",
      "properties": {
        "aihub.chatTarget": {
          "type": "string",
          "enum": [
            "auto",
            "copilot",
            "opencode"
          ],
          "default": "auto",
          "description": "Where actions go. auto: an open opencode terminal if there is one, otherwise Copilot Chat. The text is put in the chat input; you press Enter yourself."
        },
        "aihub.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "description": "How often the status is refreshed while the window has focus. The window also refreshes when it gets focus and when the git branch changes. No polling while the window is not focused."
        },
        "aihub.fabric.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the Fabric section (runs and failures of the branch's feature workspace via aihub fabric). Hidden automatically when the branch has no workspace."
        },
        "aihub.cliPath": {
          "type": "string",
          "default": "aihub",
          "description": "The aihub command. Change this only when aihub is not on the PATH."
        },
        "aihub.timeoutSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "Time limit for one aihub call."
        },
        "aihub.chatAgentName": {
          "type": "string",
          "default": "aihub",
          "description": "The Copilot Chat agent selected when an action opens the chat (installed by aihub skills install). When it is not installed the default agent is used and the install command is offered once."
        },
        "aihub.chatAgentMode": {
          "type": "boolean",
          "default": true,
          "description": "Open Copilot Chat in agent mode, so the slash commands (/pr, /review, ...) of the aihub pack work."
        },
        "aihub.worktrees.setsRoot": {
          "type": "string",
          "default": "",
          "description": "Folder that holds the worktree sets (one folder per branch). Empty: C:\\git\\worktrees on Windows, ~/git/worktrees elsewhere."
        },
        "aihub.worktrees.repoRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Folders scanned for repositories when creating a set. Empty: the parent folders of the workspace folders."
        },
        "aihub.worktrees.scanDepth": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 5,
          "description": "How many folder levels below each repo root are scanned for repositories."
        },
        "aihub.worktrees.baseBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "staging",
            "main"
          ],
          "description": "Base branches offered for a new branch in a set."
        },
        "aihub.performanceLog.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Keep a local performance log of what the extension costs: activation per phase, commands, status reads, every child process (git, aihub, az), timers, watchers, notifications, and every 30-60 s the event-loop delay, CPU and memory of the extension host. JSON lines under the extension's global storage (perf/), at most 10 MB per day, 7 days kept, never sent anywhere. No tokens, e-mail addresses or file contents. See AI Context Hub: Show Performance Report."
        },
        "aihub.performanceLog.level": {
          "type": "string",
          "enum": [
            "basic",
            "verbose"
          ],
          "default": "basic",
          "enumDescriptions": [
            "One host sample per minute; timers and watchers as counts in the sample.",
            "One host sample every 30 s, plus a line per timer fire and watcher event."
          ],
          "description": "How much the performance log keeps."
        },
        "aihub.worktrees.remote": {
          "type": "string",
          "default": "origin",
          "description": "Remote used to fetch, sync and push sets."
        },
        "aihub.storyWorktrees.autoMarkCurrent": {
          "type": "string",
          "enum": [
            "ask",
            "auto",
            "off"
          ],
          "enumDescriptions": [
            "Ask once when you clearly work in another branch of the story than its ★",
            "Move the ★ yourself, with an Undo button",
            "Never"
          ],
          "default": "ask",
          "description": "The ★ of a story follows the branch you really work in (saves, edits, focus time, commits; counted locally in story-worktrees.json)."
        },
        "aihub.set": {
          "type": "object",
          "scope": "window",
          "default": null,
          "description": "Written by aihub into the .code-workspace of a repo set (story, group, branch, mode, repositories); the status bar shows it. Not meant to be edited."
        }
      }
    },
