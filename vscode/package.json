      "comments/commentThread/title": [
        {
          "command": "aihub.thread.resolve",
          "group": "inline@1",
          "when": "commentController == aihub && commentThread == aihubOpen"
        },
        {
          "command": "aihub.thread.wontFix",
          "group": "inline@2",
          "when": "commentController == aihub && commentThread == aihubOpen"
        },
        {
          "command": "aihub.thread.fixInChat",
          "group": "inline@3",
          "when": "commentController == aihub && commentThread == aihubOpen"
        },
        {
          "command": "aihub.thread.reactivate",
          "group": "inline@1",
          "when": "commentController == aihub && commentThread == aihubResolved"
        }
